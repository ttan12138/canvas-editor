{
  "name": "@hufe921/canvas-editor",
  "author": "Hufe",
  "license": "MIT",
  "version": "0.9.133",
  "description": "A Canvas/SVG-based rich text editor",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "lib",
    "build",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "typings": "./lib/src/editor/index.d.ts",
  "main": "./lib/canvas-editor.umd.cjs",
  "module": "./lib/canvas-editor.js",
  "homepage": "https://github.com/Hufe921/canvas-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hufe921/canvas-editor.git"
  },
  "keywords": [
    "canvas-editor",
    "editor",
    "wysiwyg",
    "emr"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lib": "eslint . && tsc && vitest run && vite build --mode lib && pnpm exec babel lib/canvas-editor.js --out-file lib/canvas-editor.js && pnpm exec babel lib/canvas-editor.umd.cjs --out-file lib/canvas-editor.umd.cjs",
    "build": "eslint . && tsc && vitest run && vite build --mode app",
    "serve": "vite preview",
    "lint": "eslint . && tsc --noEmit && vitest run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type:check": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "postinstall": "simple-git-hooks",
    "pre-release": "node scripts/pre-release.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.3",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-legacy": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "core-js": "^3.49.0",
    "cypress": "^15.14.2",
    "cypress-file-upload": "^5.0.8",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "regenerator-runtime": "^0.14.1",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.48.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "vitest-canvas-mock": "^1.1.4",
    "vue": "^3.5.34"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "intersection-observer": "^0.12.2",
    "prismjs": "^1.27.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run type:check",
    "commit-msg": "node scripts/verifyCommit.js"
  }
}
